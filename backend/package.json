{
  "name": "sidequest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end REST API per SideQuest (UNINA)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:init": "tsx src/scripts/initDatabase.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "test": "npm run build && node --test tests/*.cjs",
    "test:integration": "npm run build && node --test tests/accounts.integration.cjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "tar": "7.5.22",
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
