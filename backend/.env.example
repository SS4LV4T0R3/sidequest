NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TZ=Europe/Rome
# Origine ammessa per le scritture; il nome resta compatibile con la configurazione Azure.
# Le API sono raggiunte tramite /api sulla stessa origine del frontend, senza middleware CORS.
CORS_ORIGIN=http://localhost:4200
# I percorsi relativi partono da backend/, anche dopo la compilazione.
DB_STORAGE=./database.sqlite

# Su Azure Windows impostare DB_STORAGE=D:\home\data\database.sqlite, fuori dalla cartella del codice.

# Solo per npm run admin:create: impostare valori propri, poi rimuoverli da .env.
# ADMIN_EMAIL=
# ADMIN_NICKNAME=
# ADMIN_PASSWORD=
